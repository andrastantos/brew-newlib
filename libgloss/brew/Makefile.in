# Makefile for libgloss/spro. This is the board support code for the
# brew target.

DESTDIR =
VPATH = @srcdir@ @srcdir@/..
srcdir = @srcdir@
objdir = .
srcroot = $(srcdir)/../..
objroot = $(objdir)/../..

prefix = @prefix@
exec_prefix = @exec_prefix@

host_alias = @host_alias@
target_alias = @target_alias@

bindir = @bindir@
libdir = @libdir@
tooldir = $(exec_prefix)/$(target_alias)

# Multilib support variables.
# TOP is used instead of MULTI{BUILD,SRC}TOP.
MULTIDIRS =
MULTISUBDIR =
MULTIDO = true
MULTICLEAN = true

INSTALL = @INSTALL@
INSTALL_PROGRAM = @INSTALL_PROGRAM@
INSTALL_DATA = @INSTALL_DATA@
mkinstalldirs = $(SHELL) $(srcroot)/mkinstalldirs

SHELL = /bin/sh

CC = @CC@

AS = @AS@
AR = @AR@
LD = @LD@
RANLIB = @RANLIB@
AR_FLAGS = rc

OBJDUMP = `if [ -f ${objroot}/../binutils/objdump ] ; \
	then echo ${objroot}/../binutils/objdump ; \
	else t='$(program_transform_name)'; echo objdump | sed -e $$t ; fi`
OBJCOPY = `if [ -f ${objroot}/../binutils/objcopy ] ; \
	then echo ${objroot}/../binutils/objcopy ; \
	else t='$(program_transform_name)'; echo objcopy | sed -e $$t ; fi`

LD_SCRIPTS = brew-elf-common.ld sim.ld

# Two board support packages, one per environment (the simulator's
# --environment user|operating; gcc -menvironment=user|operating). Each is
# built from, and installed into, a subdirectory named after its environment,
# with the same file names: <env>/crt0.o and <env>/libbrew.a. Sources shared
# by both are in this directory.
#
# user_env:      TASK mode under an OS or the simulator, which provides the
#                syscalls (syscall-template.S) and sets up $sp.
# operating_env: bare metal from reset (SCHEDULER mode); drives the console
#                and simulator-control devices directly.
ENVS = user_env operating_env

# user_env: every syscall stub is syscall-template.S with FN_NAME=_<name>
# and SYSCALL_NO=SYS_<name>.
USER_SYSCALLS = exit open close read write lseek unlink getpid kill fstat \
	chdir chmod utime time gettimeofday times link
USER_OBJS = $(addprefix user_env/,$(addsuffix .o,$(USER_SYSCALLS)) \
	stat.o isatty.o sbrk.o)

# operating_env: device drivers, plus ENOSYS stubs (nosys.c with
# FN_NAME=_<name>) for what has no device behind it.
OPERATING_NOSYS = open close lseek unlink stat chdir chmod utime time \
	gettimeofday times link
OPERATING_OBJS = $(addprefix operating_env/,$(addsuffix .o,$(OPERATING_NOSYS)) \
	devices.o read.o write.o exit.o kill.o getpid.o isatty.o fstat.o sbrk.o)

COMPILE = $(CC) $(CFLAGS_FOR_TARGET) $(INCLUDES) -I$(srcdir) -I$(srcdir)/$(@D) $(CFLAGS)

#### Host specific Makefile fragment comes in here.
@host_makefile_frag@

# Only the rules below: make's built-in .c.o rule would find the sources
# through VPATH and put the objects in this directory.
.SUFFIXES:

all: $(addsuffix /crt0.o,$(ENVS)) $(addsuffix /libbrew.a,$(ENVS))

user_env/libbrew.a: $(USER_OBJS)
operating_env/libbrew.a: $(OPERATING_OBJS)
user_env/libbrew.a operating_env/libbrew.a:
	rm -f $@
	$(AR) $(AR_FLAGS) $@ $^
	$(RANLIB) $@

%/crt0.o: $(srcdir)/%/crt0.S
	@mkdir -p $(@D)
	$(COMPILE) -o $@ -c $<

$(addprefix user_env/,$(addsuffix .o,$(USER_SYSCALLS))): user_env/%.o: $(srcdir)/user_env/syscall-template.S
	@mkdir -p $(@D)
	$(COMPILE) -o $@ -D FN_NAME=_$* -D SYSCALL_NO=SYS_$* -c $<

user_env/isatty.o: $(srcdir)/user_env/syscall-template.S
	@mkdir -p $(@D)
	$(COMPILE) -o $@ -D FN_NAME=_isatty -D SYSCALL_NO=BREW_isatty -c $<

$(addprefix operating_env/,$(addsuffix .o,$(OPERATING_NOSYS))): operating_env/%.o: $(srcdir)/operating_env/nosys.c
	@mkdir -p $(@D)
	$(COMPILE) -o $@ -D FN_NAME=_$* -c $<

user_env/sbrk.o operating_env/sbrk.o: $(srcdir)/sbrk.c
	@mkdir -p $(@D)
	$(COMPILE) -o $@ -c $<

user_env/%.o: $(srcdir)/user_env/%.c
	@mkdir -p $(@D)
	$(COMPILE) -o $@ -c $<

operating_env/%.o: $(srcdir)/operating_env/%.c
	@mkdir -p $(@D)
	$(COMPILE) -o $@ -c $<

operating_env/%.o: $(srcdir)/operating_env/%.S
	@mkdir -p $(@D)
	$(COMPILE) -o $@ -c $<

install:
	for env in $(ENVS); do \
	  $(mkinstalldirs) $(DESTDIR)$(tooldir)/lib$(MULTISUBDIR)/$$env; \
	  $(INSTALL_DATA) $$env/crt0.o $(DESTDIR)$(tooldir)/lib$(MULTISUBDIR)/$$env/crt0.o; \
	  $(INSTALL_DATA) $$env/libbrew.a $(DESTDIR)$(tooldir)/lib$(MULTISUBDIR)/$$env/libbrew.a; \
	done
	for x in ${LD_SCRIPTS}; do \
	  ${INSTALL_DATA} ${srcdir}/$$x $(DESTDIR)${tooldir}/lib/$$x; \
	done;

clean mostlyclean:
	rm -f *.o *.a $(addsuffix /*.o,$(ENVS)) $(addsuffix /*.a,$(ENVS))

distclean maintainer-clean realclean: clean
	rm -f Makefile

.PHONY: info dvi doc install-info clean-info
info doc dvi:
install-info:
clean-info:

Makefile: Makefile.in ../config.status
	cd .. && $(SHELL) config.status
